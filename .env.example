# A-Plus Fashion Home — environment variables
# Copy to .env.local for local dev. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser; everything else is server-only.

# ---------- Site ----------
# Public origin, no trailing slash. Used for OAuth redirects, Paystack callback URLs and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Postgres, Auth, Storage) ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS; used by lib/db.ts for all server data access. Rotate if ever exposed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Admin access (REQUIRED — fails closed if empty) ----------
# Comma-separated Google account emails allowed into /admin.
# The same email must ALSO exist in the public.admins table (see supabase/seed.sql).
ADMIN_EMAILS=henryaplus82@gmail.com

# ---------- Paystack ----------
# Server-only. sk_test_... for development, sk_live_... in production.
# If unset, checkout returns 503 and the store falls back to "order via WhatsApp".
PAYSTACK_SECRET_KEY=sk_test_your_key

# ---------- Mailgun (transactional email) ----------
# If unset, emails are skipped with a console warning (orders still work).
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM="A-Plus Fashion Home <orders@mg.yourdomain.com>"
# Only for EU-region Mailgun domains. Default: https://api.mailgun.net
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Test checkout (order confirmed, no payment taken) for signed-in shoppers. Server-only.
# Also switches on automatically while the Paystack keys are empty. '*' = everyone; or list emails.
# Remove (and set the Paystack keys) before going live.
TEST_ORDER_EMAILS=

# A-Plus Fashion Home Environment Variables
# Note: Never commit secrets to git.

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (Payments)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample
PAYSTACK_SECRET_KEY=sk_test_sample

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://sample-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sample-anon-key
SUPABASE_SERVICE_ROLE_KEY=sample-service-role-key

# Mailgun (Transactional Emails)
MAILGUN_API_KEY=sample-mailgun-api-key
MAILGUN_DOMAIN=mg.aplusfashion.ng
MAILGUN_FROM="A-Plus Fashion Home <orders@mg.aplusfashion.ng>"

# Admin Access Control (Owner email allow-list, comma-separated)
ADMIN_EMAILS=henryaplus82@gmail.com
